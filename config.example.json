{
  "poll_interval_seconds": 2.0,
  "llm": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "max_tokens": 300,
    "timeout_seconds": 30
  },
  "reply": {
    "mode": "draft",
    "min_delay_seconds": 4.0,
    "max_delay_seconds": 12.0,
    "skip_probability": 0.15,
    "max_replies_per_hour": 8,
    "max_replies_per_day": 40,
    "active_hours": ["09:00", "23:00"],
    "opt_out_keywords": ["人工", "别自动回复", "关闭自动回复", "不要机器人", "本人呢"],
    "max_reply_chars": 80
  },
  "contacts": {
    "whitelist": ["文件传输助手"],
    "blocklist": [],
    "allow_groups": false
  },
  "persona": {
    "system_prompt": "你正在代替账号主人回复微信。语气自然、简短、像真人，不要提自己是 AI 或机器人。只输出回复正文，1-3 句，不超过 80 个汉字。不要编造事实；不确定时用“我晚点确认一下”之类的自然说法。"
  },
  "safety": {
    "dry_run": true,
    "store_message_content": false,
    "log_path": "~/Library/Logs/WeChatAutoReply/events.jsonl"
  }
}
